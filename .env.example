# Copy this file to .env and put in your own Portkey key:
#   cp .env.example .env
# The app looks for .env in this folder first, then in the folder one level above.
# Never commit or share the real .env (it's in .gitignore).
PORTKEY_API_KEY=your-portkey-api-key-here
# The only model allowed on the course key. Use the plain name (no "openai/" prefix).
MODEL=gpt-6-luna
